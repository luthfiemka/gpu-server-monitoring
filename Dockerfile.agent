FROM golang:1.23-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src
COPY agent/ .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /out/gpu-monitoring-agent-linux-amd64 ./cmd/agent
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -ldflags="-s -w" -o /out/gpu-monitoring-agent-linux-arm64 ./cmd/agent

FROM scratch
COPY --from=builder /out/gpu-monitoring-agent-linux-amd64 /gpu-monitoring-agent-linux-amd64
COPY --from=builder /out/gpu-monitoring-agent-linux-arm64 /gpu-monitoring-agent-linux-arm64
ENTRYPOINT ["/bin/sh"]
